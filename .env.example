# Copy this file to .env and fill in your values.

# Required for LLM-generated answers (query rewriting, RAG answers, diagnosis,
# follow-up suggestions). Without it, the app still runs in "retrieval-only"
# mode: it will find and cite the right manual passages but won't compose a
# natural-language answer.
ANTHROPIC_API_KEY=

# Model to use for generation.
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2

# Embedding + reranker models (swappable, e.g. BAAI/bge-small-en-v1.5)
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
USE_RERANKER=true

# Retrieval tuning
TOP_K_RETRIEVE=20
TOP_K_FINAL=5
VECTOR_WEIGHT=0.6
BM25_WEIGHT=0.4
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# FastAPI backend
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
